# syntax=docker/dockerfile:1

FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY web/ ./

ARG APP_VERSION=dev
RUN VITE_REACT_APP_VERSION="${APP_VERSION}" bun run build

FROM nginx/nginx-unprivileged:1.30.6-alpine AS runtime

LABEL org.opencontainers.image.title="new-api frontend" \
      org.opencontainers.image.authors="QuantumNous" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

# For separate services, set this to the backend's internal HTTP address.
# The default also works for two containers in a single ECS task.
ENV BACKEND_URL=http://127.0.0.1:3000 \
    NGINX_ENVSUBST_FILTER="^BACKEND_URL$"

COPY --from=build /build/web/dist/ /usr/share/nginx/html/
COPY docker/frontend/default.conf.template /etc/nginx/templates/default.conf.template
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/

EXPOSE 8080
